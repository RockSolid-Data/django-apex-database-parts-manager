{
  "python.defaultInterpreterPath": "${workspaceFolder}/venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,
  "python.terminal.activateEnvInCurrentTerminal": true,
  "files.watcherExclude": {
    "**/build/**": true,
    "**/dist/**": true,
    "**/media/**": true,
    "**/venv/**": true,
    "**/_staging_dbs_tmp/**": true,
    "**/_dev_archive/**": true,
    "**/staticfiles/**": true,
    "**/__pycache__/**": true,
    "**/.cache/**": true,
    "**/seed.sqlite3": true,
    "**/db.sqlite3": true,
    "**/db.sqlite3-*": true,
    "**/.git/lfs/**": true,
    "**/.git/objects/**": true
  },
  "search.exclude": {
    "**/build/**": true,
    "**/dist/**": true,
    "**/media/**": true,
    "**/venv/**": true,
    "**/_staging_dbs_tmp/**": true,
    "**/seed.sqlite3": true,
    "**/db.sqlite3": true
  },
  "git.autofetch": false
}
